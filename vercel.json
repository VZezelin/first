{
  "rewrites": [
    {
      "source": "/.well-known/agent-skills/index.json",
      "destination": "/api/view?discovery=agent-skills"
    }
  ],
  "redirects": [
    {
      "source": "/youtube-transcript-api.md",
      "destination": "/youtube-transcript-api.html",
      "permanent": true
    },
    {
      "source": "/website-to-markdown-api.md",
      "destination": "/website-to-markdown-api.html",
      "permanent": true
    },
    {
      "source": "/job-posting-scraper-api.md",
      "destination": "/job-posting-scraper-api.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/agent-skills/index.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", </.well-known/agent-skills/index.json>; rel=\"alternate\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/youtube-transcript-api.html",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", <https://raw.githubusercontent.com/VZezelin/first/main/youtube-transcript-api.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/website-to-markdown-api.html",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", <https://raw.githubusercontent.com/VZezelin/first/main/website-to-markdown-api.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/job-posting-scraper-api.html",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/markdown\", <https://raw.githubusercontent.com/VZezelin/first/main/job-posting-scraper-api.md>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    }
  ]
}
